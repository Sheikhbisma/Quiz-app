{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": { "runtime": "vercel-php@0.6.0" }
    },
    "routes": [
        { "src": "/(css|js|images|fonts|favicon)/(.*)", "dest": "/public/$1/$2" },
        { "src": "/(.*)\\.(.+)$", "dest": "/public/$1.$2" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://your-url.vercel.app",
        "APP_KEY": "base64:ItH3XJyZz/mKuH8MQt/9ER0+Nbmyt5RY38l9+ACFSuQ=",
        "LOG_CHANNEL": "stderr",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie"
    }
}